if rust_target is None:
    sys.exit("Non trovo il comando Tauri: Google Maps non può aprirsi.")
rust = rust_target.read_text()
if "fn open_external" not in rust:
    command = '''
#[tauri::command]
fn open_external(url: String) -> Result<(), String> {
    if !(url.starts_with("https://www.google.com/maps") || url.starts_with("https://maps.google.com/")) {
        return Err("Si può aprire solo un percorso di Google Maps.".into());
    }
    std::process::Command::new("open").arg(url).spawn().map_err(|error| error.to_string())?;
    Ok(())
}

'''
    uses = list(re.finditer(r"(?m)^use .*;\n", rust))
    at = uses[-1].end() if uses else 0
    rust = rust[:at] + command + rust[at:]

def add_open_external(match: re.Match[str]) -> str:
    body = match.group(2)
    if re.search(r"\bopen_external\b", body):
        return match.group(0)
    stripped = body.rstrip()
    if not stripped:
        return match.group(1) + "open_external" + match.group(3)
    if not stripped.endswith(","):
        stripped += ","
    return match.group(1) + stripped + "\n    open_external,\n" + match.group(3)

rust2, wired = re.subn(r"(tauri::generate_handler!\[)(.*?)(\])", add_open_external, rust, count=1, flags=re.S)
if not wired or "fn open_external" not in rust2 or not re.search(r"generate_handler!\[[^\]]*open_external", rust2, re.S):
    sys.exit("Non riesco a collegare l’apertura di Google Maps.")
rust_target.write_text(rust2)
print(f"Google Maps si apre dal browser di sistema ({rust_target.name}).")
