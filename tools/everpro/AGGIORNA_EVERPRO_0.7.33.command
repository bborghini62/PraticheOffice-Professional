def bump(path: Path, pattern: str) -> None:
    if not path.is_file():
        return
    text = path.read_text()
    updated, count = re.subn(pattern, r"\g<1>0.7.33\2", text, count=1)
    if count:
        path.write_text(updated)
        print(f"Versione 0.7.33 in {path.name}")

bump(root / "package.json", r'("version"\s*:\s*")[^"]*(")')
bump(root / "src-tauri" / "tauri.conf.json", r'("version"\s*:\s*")[^"]*(")')
bump(root / "src-tauri" / "Cargo.toml", r'(?m)^(version\s*=\s*")[^"]*(")')

rust_files = list((root / "src-tauri" / "src").glob("*.rs")) if (root / "src-tauri" / "src").is_dir() else []
