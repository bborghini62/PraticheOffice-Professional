if "fn mail_file" not in rust:
    command = r'''
#[tauri::command]
fn mail_file(path: String, subject: String, body: String) -> Result<(), String> {
    let file = std::path::Path::new(&path);
    let pdf = file
        .extension()
        .and_then(|ext| ext.to_str())
        .map(|ext| ext.eq_ignore_ascii_case("pdf"))
        .unwrap_or(false);
    if !pdf || !file.is_file() {
        return Err("Si può allegare solo un PDF di EverPro.".into());
    }
    let escape = |value: &str| {
        let mut out = String::new();
        for ch in value.chars() {
            if ch == '\\' || ch == '"' {
                out.push('\\');
            }
            if ch != '\r' && ch != '\n' {
                out.push(ch);
            }
        }
        out
    };
    let subject = escape(&subject);
    let path = escape(&path);
    let clipped: String = body.chars().take(6000).collect();
    let mut lines: Vec<String> = clipped
        .split('\n')
        .map(|line| format!("\"{}\"", escape(line)))
        .filter(|line| line != "\"\"")
        .collect();
    if lines.is_empty() {
        lines.push("\"Viaggi EverPro in allegato.\"".to_string());
    }
    let content = lines.join(" & return & ");
    let script = format!(
        "tell application \"Mail\"\nset theMessage to make new outgoing message with properties {{subject:\"{subject}\", content:{content}, visible:true}}\ntell theMessage\nmake new attachment with properties {{file name:(POSIX file \"{path}\")}} at after the last paragraph\nend tell\nactivate\nend tell"
    );
    let status = std::process::Command::new("osascript")
        .arg("-e")
        .arg(script)
        .status()
        .map_err(|error| error.to_string())?;
    if status.success() {
        Ok(())
    } else {
        Err("Mail non si apre.".into())
    }
}

'''
    uses = list(re.finditer(r"(?m)^use .*;\n", rust))
    at = uses[-1].end() if uses else 0
    rust = rust[:at] + command + rust[at:]

def add_mail(match: re.Match[str]) -> str:
    body = match.group(2)
    if re.search(r"\bmail_file\b", body):
        return match.group(0)
    stripped = body.rstrip()
    if not stripped:
        return match.group(1) + "mail_file" + match.group(3)
    if not stripped.endswith(","):
        stripped += ","
    return match.group(1) + stripped + "\n    mail_file,\n" + match.group(3)

rust2, wired = re.subn(r"(tauri::generate_handler!\[)(.*?)(\])", add_mail, rust, count=1, flags=re.S)
if not wired or "fn mail_file" not in rust2 or not re.search(r"generate_handler!\[[^\]]*mail_file", rust2, re.S):
    sys.exit("Non riesco a collegare Mail.")
rust_target.write_text(rust2)
print(f"Mail apre il PDF dei viaggi selezionati ({rust_target.name}).")

