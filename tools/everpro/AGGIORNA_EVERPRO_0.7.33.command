(root / "src" / "tripPrint.ts").write_bytes(base64.b64decode("".join(payload.split())))
printed = (root / "src" / "tripPrint.ts").read_text()
if "Punti del percorso" not in printed or "const mainStops" not in printed:
    sys.exit("Stampa senza i punti del percorso")
if "fetch_map" not in printed:
    sys.exit("Stampa senza richiesta mappa")
rust_files = list((root / "src-tauri" / "src").glob("*.rs")) if (root / "src-tauri" / "src").is_dir() else []
rust_target = next((path for path in rust_files if "generate_handler!" in path.read_text()), None)
if rust_target is None:
    sys.exit("Non trovo il comando Tauri: la mappa non puo aprirsi.")
rust = rust_target.read_text()
command = r"""
#[tauri::command]
fn fetch_map(url: String) -> Result<String, String> {
    let tile = "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/";
    let geo = "https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/reverseGeocode?";
    let allowed = url.starts_with(tile) || url.starts_with(geo);
    let dirty = url.chars().any(|ch| {
        ch.is_whitespace() || ch == '"' || ch == '\'' || ch == '`' || ch == '\\' || ch == ';'
    });
    if !allowed || dirty || url.contains("..") {
        return Err("Indirizzo mappa non consentito.".into());
    }
    let output = std::process::Command::new("curl")
        .args(["-fsSL", "--proto", "=https", "--max-redirs", "2", "--max-time", "20", "-A", "EverPro/0.7.33", &url])
        .output()
        .map_err(|error| error.to_string())?;
    if !output.status.success() || output.stdout.is_empty() || output.stdout.len() > 2_000_000 {
        return Err("Mappa non disponibile.".into());
    }
    Ok(encode_base64(&output.stdout))
}

fn encode_base64(data: &[u8]) -> String {
    const TABLE: &[u8] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    let mut out = String::new();
    let mut index = 0;
    while index + 3 <= data.len() {
        let value = ((data[index] as u32) << 16) | ((data[index + 1] as u32) << 8) | (data[index + 2] as u32);
        out.push(TABLE[((value >> 18) & 63) as usize] as char);
        out.push(TABLE[((value >> 12) & 63) as usize] as char);
        out.push(TABLE[((value >> 6) & 63) as usize] as char);
        out.push(TABLE[(value & 63) as usize] as char);
        index += 3;
    }
    if index < data.len() {
        let rest = data.len() - index;
        let value = if rest == 1 {
            (data[index] as u32) << 16
        } else {
            ((data[index] as u32) << 16) | ((data[index + 1] as u32) << 8)
        };
        out.push(TABLE[((value >> 18) & 63) as usize] as char);
        out.push(TABLE[((value >> 12) & 63) as usize] as char);
        if rest == 1 {
            out.push('=');
            out.push('=');
        } else {
            out.push(TABLE[((value >> 6) & 63) as usize] as char);
            out.push('=');
        }
    }
    out
}
"""
if "fn fetch_map" not in rust:
    uses = list(re.finditer(r"(?m)^use .*;\n", rust))
    at = uses[-1].end() if uses else 0
    rust = rust[:at] + command + rust[at:]

def add_fetch(match):
    body = match.group(2)
    if re.search(r"\bfetch_map\b", body):
        return match.group(0)
    stripped = body.rstrip()
    if not stripped:
        return match.group(1) + "fetch_map" + match.group(3)
    if not stripped.endswith(","):
        stripped += ","
    return match.group(1) + stripped + "\n    fetch_map,\n" + match.group(3)

rust2, wired = re.subn(r"(tauri::generate_handler!\[)(.*?)(\])", add_fetch, rust, count=1, flags=re.S)
if not wired or "fn fetch_map" not in rust2 or not re.search(r"generate_handler!\[[^\]]*fetch_map", rust2, re.S):
    sys.exit("Non riesco a collegare la mappa.")
rust_target.write_text(rust2)
print("La mappa segna la strada e i punti principali.")
PY
if [[ $? -ne 0 ]]; then
  echo "AGGIORNAMENTO FERMATO. Non compilo la versione precedente."
  exit 1
fi
if ! grep -q "Punti del percorso" "$PROJ/src/tripPrint.ts" || ! grep -q "fn fetch_map" "$PROJ"/src-tauri/src/*.rs; then
  echo "ERRORE: la mappa non segna i punti principali. Non compilo."
  exit 1
fi
python3 - "$PROJ" << 'PY'
from pathlib import Path
import sys
root = Path(sys.argv[1])
app_path = root / "src" / "App.tsx"
app = app_path.read_text()
fixes = (
    (
        "onPrint={(chosen) => void printSelectedTrips(chosen, withRoute)}",
        "onPrint={(chosen, includeRoute) => void printSelectedTrips(chosen, includeRoute)}",
    ),
    (
        "onMail={(chosen) => void mailSelectedTrips(chosen, withRoute)}",
        "onMail={(chosen, includeRoute) => void mailSelectedTrips(chosen, includeRoute)}",
    ),
    (
        "onPrint={(chosen) => void printSelectedTrips(chosen)}",
        "onPrint={(chosen, includeRoute) => void printSelectedTrips(chosen, includeRoute)}",
    ),
    (
        "onMail={(chosen) => void mailSelectedTrips(chosen)}",
        "onMail={(chosen, includeRoute) => void mailSelectedTrips(chosen, includeRoute)}",
    ),
)
for old, new in fixes:
    if old in app and new not in app:
        app = app.replace(old, new, 1)
app_path.write_text(app)
app = app_path.read_text()
if "onPrint={(chosen, includeRoute) => void printSelectedTrips(chosen, includeRoute)}" not in app:
    sys.exit("Stampa non collegata")
if "onMail={(chosen, includeRoute) => void mailSelectedTrips(chosen, includeRoute)}" not in app:
    sys.exit("Mail non collegata")
if "printTripReport(chosen, includeRoute)" not in app or "mailTripReport(chosen, includeRoute)" not in app:
    sys.exit("Le funzioni non passano il percorso")
print("Stampa e Mail aprono il PDF dei viaggi selezionati.")
PY
if [[ $? -ne 0 ]]; then
  echo "AGGIORNAMENTO FERMATO. Non compilo la versione precedente."
  exit 1
fi
if ! grep -q 'onPrint={(chosen, includeRoute)' "$PROJ/src/App.tsx" || ! grep -q 'onMail={(chosen, includeRoute)' "$PROJ/src/App.tsx"; then
  echo "ERRORE: Stampa e Mail non sono collegate. Non compilo."
  exit 1
fi
echo ""
echo "Compilo EverPro desktop. Può volerci un po'."
if [[ -f "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
fi
cd "$PROJ"
LOG="$HOME/Desktop/everpro-desktop-percorso.log"
npm run tauri build -- --bundles app >"$LOG" 2>&1 &
XPID=$!
while kill -0 "$XPID" >/dev/null 2>&1; do
  sleep 12
  LINE=$(tail -1 "$LOG" 2>/dev/null || true)
  echo "… ${LINE:0:140}"
done
wait "$XPID"
BUILD_OK=$?
if [[ "$BUILD_OK" -ne 0 ]]; then
  echo "COMPILAZIONE FALLITA."
  tail -40 "$LOG"
  echo "Log: $LOG"
  exit 1
fi

APP=$(find "$PROJ/src-tauri/target/release/bundle/macos" -name 'EverPro.app' -type d 2>/dev/null | head -1)
if [[ -z "$APP" ]]; then
  APP=$(find "$PROJ/src-tauri/target" -name 'EverPro.app' -type d -path '*release/bundle/macos/*' 2>/dev/null | head -1)
fi
echo ""
echo "FATTO."
if [[ -n "$APP" ]]; then
  osascript -e 'quit app "EverPro"' >/dev/null 2>&1 || true
  sleep 1
  rm -rf "/Applications/EverPro.app"
  ditto "$APP" "/Applications/EverPro.app"
  echo "EverPro è in Applicazioni. Lo apro."
  open "/Applications/EverPro.app"
else
  echo "App compilata. Cercala in $PROJ/src-tauri/target/release/bundle/macos"
  open "$PROJ/src-tauri/target/release/bundle/macos"
fi
echo "In alto a sinistra deve comparire 0.7.33."
echo "Nella pratica la trasferta si legge come percorso, non come codice."
echo "I chilometri sono quelli del percorso registrato dall'iPhone."
echo "Su un viaggio assegnato si vede la pratica e si può cambiare."
echo "I viaggi a 0 km non vengono registrati."
echo "Andata e ritorno raddoppia km, tempo e totale, e la scheda mostra anche il percorso di andata."
echo "A destra compaiono solo i viaggi spuntati in questa colonna."
echo "Stampa apre l'anteprima del PDF. Mail apre il messaggio con il PDF allegato."
echo "Con percorso, nella stampa e nella mail compare la mappa: la strada percorsa e i punti principali, oltre a partenza e arrivo."
