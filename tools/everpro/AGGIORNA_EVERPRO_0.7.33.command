#!/bin/zsh
set -u
echo ""
echo "============================================"
echo " QUESTO È IL FILE NUOVO — EverPro desktop 0.7.33"
echo "============================================"
echo "Script: $0"
echo ""

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "ERRORE: va lanciato sul Mac."
  exit 1
fi

PATCH="$HOME/Desktop/everpro-sorgenti-0.7.33"
mkdir -p "$PATCH"
python3 - "$PATCH" << 'PY'
import base64, sys
from pathlib import Path
root = Path(sys.argv[1])
files = {
    "TripArchive.tsx": "",
    "SelectedTrips.tsx": "",
    "openExternal.ts": "",
    "AssignPractice.tsx": "",
    "TripEditor.tsx": "",
}
for name, payload in files.items():
    path = root / name
    path.write_bytes(base64.b64decode(payload))
    print(f"Scritto {path}")
PY
if ! grep -q "selectedIds" "$PATCH/TripArchive.tsx" || ! grep -q "Assegnato a" "$PATCH/TripArchive.tsx" || ! grep -q "tripDistanceMeters(trip) > 0" "$PATCH/TripArchive.tsx" || grep -q "useState" "$PATCH/TripArchive.tsx" || ! grep -q "Cambia pratica" "$PATCH/SelectedTrips.tsx" || ! grep -q "non viene registrato" "$PATCH/TripEditor.tsx" || ! grep -q "Andata e ritorno" "$PATCH/SelectedTrips.tsx"; then
  echo "ERRORE: i sorgenti del 0.7.33 non sono completi."
  exit 1
fi

echo "File giusti: assegnazione visibile e modificabile, niente viaggi a 0 km, scheda pratica leggibile."

PROJ=$(python3 - <<'PY'
import json
from pathlib import Path
best = None
best_key = ()
root = Path("/Volumes/Disco_Dati/Evernote")
if not root.exists():
    raise SystemExit(0)
for candidate in root.glob("EverPro-Desktop-*"):
    needed = [candidate / "src/App.tsx", candidate / "src/trips.ts", candidate / "src/TripArchive.tsx", candidate / "package.json"]
    if not all(path.is_file() for path in needed):
        continue
    version = json.loads((candidate / "package.json").read_text()).get("version", "0")
    print(f"Trovato {candidate} ({version})", file=__import__("sys").stderr)
    key = tuple(int(part) if part.isdigit() else 0 for part in str(version).split("."))
    if key >= best_key:
        best_key = key
        best = candidate
if best:
    print(best)
PY
)
if [[ -z "$PROJ" ]]; then
  echo "ERRORE: non trovo EverPro desktop su Disco_Dati."
  exit 1
fi
echo "Aggiorno: $PROJ"
echo ""

cp -p "$PATCH/TripArchive.tsx" "$PROJ/src/TripArchive.tsx"
if grep -q "AssignPractice" "$PROJ/src/TripArchive.tsx"; then
  echo "ERRORE: l'archivio ha ancora Cerca pratica su ogni viaggio. Non compilo."
  exit 1
fi
cp -p "$PATCH/SelectedTrips.tsx" "$PROJ/src/SelectedTrips.tsx"
cp -p "$PATCH/openExternal.ts" "$PROJ/src/openExternal.ts"
cp -p "$PATCH/AssignPractice.tsx" "$PROJ/src/AssignPractice.tsx"
if [[ -f "$PATCH/TripEditor.tsx" ]]; then
  cp -p "$PATCH/TripEditor.tsx" "$PROJ/src/TripEditor.tsx"
fi
echo "Aggiornati elenco viaggi e pannello a destra."

python3 - "$PROJ/src/trips.ts" "$PROJ/src/App.tsx" "$PROJ" <<'PY'
import json, re, sys
from pathlib import Path
trips_path, app_path, root = Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3])
trips = trips_path.read_text()
broken_join = '.join("' + "\n" + '")'
fixed_join = '.join("\\n")'
trips = trips.replace(broken_join, fixed_join)
field = "manualDistanceMeters?: number | null;"
if "manualDurationSeconds?" not in trips:
    if field not in trips:
        sys.exit("Campo chilometri non trovato")
    trips = trips.replace(field, field + "\n  manualDurationSeconds?: number | null;", 1)
if "privateUse?" not in trips:
    if "manualDurationSeconds?: number | null;" not in trips:
        sys.exit("Campo tempo non trovato")
    trips = trips.replace("manualDurationSeconds?: number | null;", "manualDurationSeconds?: number | null;\n  privateUse?: boolean | null;\n  legs?: TripRecord[] | null;", 1)
old_duration = """export const tripDurationSeconds = (trip: TripRecord) => {
  const end = trip.endedAt ?? Date.now();
  return Math.max(0, Math.round((end - trip.startedAt) / 1000));
};"""
new_duration = """export const tripDurationSeconds = (trip: TripRecord) => {
  if (trip.manualDurationSeconds && trip.manualDurationSeconds > 0) return Math.round(trip.manualDurationSeconds);
  const end = trip.endedAt ?? Date.now();
  return Math.max(0, Math.round((end - trip.startedAt) / 1000));
};"""
if old_duration in trips:
    trips = trips.replace(old_duration, new_duration, 1)
elif "trip.manualDurationSeconds && trip.manualDurationSeconds > 0" not in trips:
    sys.exit("Calcolo tempo non trovato")
merge_fn = '''export const mergeTripsIntoRoute = (trips: TripRecord[]): TripRecord => {
  const ordered = trips.slice().sort((a, b) => a.startedAt - b.startedAt);
  const first = ordered[0];
  const last = ordered[ordered.length - 1];
  const points = ordered.flatMap((trip) => trip.points ?? []).filter((point) => Number.isFinite(point.lat) && Number.isFinite(point.lon)).sort((a, b) => a.t - b.t);
  const notes = ordered.map((trip) => trip.note.trim()).filter(Boolean);
  const distance = ordered.reduce((sum, trip) => sum + chargedDistanceMeters(trip), 0);
  const duration = ordered.reduce((sum, trip) => sum + chargedDurationSeconds(trip), 0);
  return applyCostToTrip({
    ...first,
    id: crypto.randomUUID(),
    endedAt: last.endedAt ?? last.startedAt,
    endAddress: last.endAddress,
    endPlace: last.endPlace ?? first.endPlace ?? null,
    endLat: last.endLat ?? null,
    endLon: last.endLon ?? null,
    points,
    note: [`Percorso unito da ${ordered.length} viaggi.`, ...notes].join("\\n"),
    manualDistanceMeters: distance > 0 ? distance : null,
    manualDurationSeconds: duration > 0 ? duration : null,
    roundTrip: false,
  });
};

'''
merge_fn_pat = re.compile(r"export const mergeTripsIntoRoute = \(trips: TripRecord\[\]\): TripRecord => \{.*?\n\};\n\n", re.S)
if merge_fn_pat.search(trips):
    trips = merge_fn_pat.sub(lambda _match: merge_fn, trips, count=1)
elif "export const mapsUrl" in trips:
    trips = trips.replace("export const mapsUrl", merge_fn + "export const mapsUrl", 1)
else:
    sys.exit("Nel file viaggi manca mapsUrl")

encode_old = "export const encodeTripBundle = (trips: TripRecord[]) => `${TRIP_BUNDLE_PREFIX}${JSON.stringify({ trips })}`;"
encode_new = "export const encodeTripBundle = (trips: TripRecord[]) => `${TRIP_BUNDLE_PREFIX}${JSON.stringify({ trips: trips.filter((trip) => tripDistanceMeters(trip) > 0) })}`;"
if "trips.filter((trip) => tripDistanceMeters(trip) > 0)" not in trips:
    if encode_old not in trips:
        sys.exit("Salvataggio viaggi non trovato")
    trips = trips.replace(encode_old, encode_new, 1)
preview_old = """export const tripBundlePreview = (content: string) => {
  const trips = parseTrips(content);
  if (!trips.length) return \"Nessuna trasferta\";"""
preview_new = """export const tripBundlePreview = (content: string) => {
  const trips = parseTrips(content).filter((trip) => tripDistanceMeters(trip) > 0);
  if (!trips.length) return \"Nessuna trasferta\";"""
if "parseTrips(content).filter((trip) => tripDistanceMeters(trip) > 0)" not in trips:
    if preview_old not in trips:
        sys.exit("Anteprima trasferte non trovata")
    trips = trips.replace(preview_old, preview_new, 1)

if "roundTrip?" not in trips:
    if "privateUse?: boolean | null;" not in trips:
        sys.exit("Campo scopi privati non trovato")
    trips = trips.replace("privateUse?: boolean | null;", "privateUse?: boolean | null;\n  roundTrip?: boolean | null;", 1)
meters_old = """export const tripDistanceText = (trip: TripRecord) => {
  const meters = tripDistanceMeters(trip);
  if (meters >= 1000) return `${(meters / 1000).toFixed(1)} km`;
  return `${Math.round(meters)} m`;
};"""
meters_new = """export const metersText = (meters: number) => {
  if (meters >= 1000) return `${(meters / 1000).toFixed(1)} km`;
  return `${Math.round(meters)} m`;
};

export const tripDistanceText = (trip: TripRecord) => metersText(tripDistanceMeters(trip));"""
if "export const metersText" not in trips:
    if meters_old not in trips:
        sys.exit("Testo chilometri non trovato")
    trips = trips.replace(meters_old, meters_new, 1)
refund_old = """export const tripRefund = (trip: TripRecord, rate = effectiveCostPerKm()) => {
  const value = (rate && rate > 0 ? rate : null) ?? (trip.costPerKm && trip.costPerKm > 0 ? trip.costPerKm : null);
  if (!value) return null;
  return (tripDistanceMeters(trip) / 1000) * value;
};"""
refund_new = """export const tripChargeFactor = (trip: TripRecord) => trip.roundTrip ? 2 : 1;

export const chargedDistanceMeters = (trip: TripRecord) => tripDistanceMeters(trip) * tripChargeFactor(trip);

export const chargedDurationSeconds = (trip: TripRecord) => tripDurationSeconds(trip) * tripChargeFactor(trip);

export const tripRefund = (trip: TripRecord, rate = effectiveCostPerKm()) => {
  const value = (rate && rate > 0 ? rate : null) ?? (trip.costPerKm && trip.costPerKm > 0 ? trip.costPerKm : null);
  if (!value) return null;
  return (chargedDistanceMeters(trip) / 1000) * value;
};"""
if "export const chargedDistanceMeters" not in trips:
    if refund_old not in trips:
        sys.exit("Calcolo costo viaggio non trovato")
    trips = trips.replace(refund_old, refund_new, 1)
plain_old = "`Percorso: ${tripDistanceText(trip)} · ${tripDurationText(tripDurationSeconds(trip))}`,"
plain_new = "`Percorso: ${metersText(chargedDistanceMeters(trip))} · ${tripDurationText(chargedDurationSeconds(trip))}${trip.roundTrip ? \" · andata e ritorno\" : \"\"}`,"
if "andata e ritorno" not in trips:
    if plain_old not in trips:
        sys.exit("Testo percorso non trovato")
    trips = trips.replace(plain_old, plain_new, 1)
    trips = trips.replace("((tripDistanceMeters(trip) / 1000) * rate)", "((chargedDistanceMeters(trip) / 1000) * rate)", 1)

if "routeDistanceMeters?" not in trips:
    anchor = "manualDistanceMeters?: number | null;"
    if anchor not in trips:
        sys.exit("Campo chilometri del telefono non trovato")
    trips = trips.replace(anchor, anchor + "\n  routeDistanceMeters?: number | null;\n  routePoints?: TripPoint[] | null;\n  routeSource?: string | null;", 1)
distance_old = """export const tripDistanceMeters = (trip: TripRecord) => {
  if (trip.manualDistanceMeters && trip.manualDistanceMeters > 0) return trip.manualDistanceMeters;
  if (trip.points.length < 2) return 0;"""
distance_new = """export const tripDistanceMeters = (trip: TripRecord) => {
  if (trip.manualDistanceMeters && trip.manualDistanceMeters > 0) return trip.manualDistanceMeters;
  if (trip.routeDistanceMeters && trip.routeDistanceMeters > 0) return trip.routeDistanceMeters;
  if (trip.points.length < 2) return 0;"""
if "trip.routeDistanceMeters && trip.routeDistanceMeters > 0" not in trips:
    if distance_old not in trips:
        sys.exit("Calcolo chilometri del telefono non trovato")
    trips = trips.replace(distance_old, distance_new, 1)

trips_path.write_text(trips)
print("Unione percorsi: somma km e tempo.")


api_path = root / "src" / "api.ts"
if api_path.is_file():
    api = api_path.read_text()
    rich = 'from "./richContent";'
    if "tripBundlePreview" not in api and rich in api:
        api = api.replace(rich, rich + "\nimport { tripBundlePreview } from \"./trips\";", 1)
    old_save = 'if (inTauri()) return invoke("save_note", { note });'
    new_save = 'if (note.content.startsWith("EVP-TRIP")) note = { ...note, preview: tripBundlePreview(note.content) };\n  if (inTauri()) return invoke("save_note", { note });'
    if 'startsWith("EVP-TRIP")' not in api and old_save in api and "tripBundlePreview" in api:
        api = api.replace(old_save, new_save, 1)
        api_path.write_text(api)
        print("Anteprima trasferte salvata come percorso.")
    elif 'startsWith("EVP-TRIP")' in api:
        print("Anteprima trasferte gia' a posto.")

app = app_path.read_text()
app = app.replace(broken_join, fixed_join)
if 'from "./SelectedTrips"' not in app:
    anchor = 'import TripArchive, { collectArchiveTrips, type ArchiveTrip } from "./TripArchive";\n'
    if anchor not in app:
        sys.exit("Import archivio non trovato in App.tsx")
    app = app.replace(anchor, anchor + 'import SelectedTrips from "./SelectedTrips";\n', 1)
if "applyCostToTrip" not in app:
    old = "encodeTripBundle, isTripContent"
    if old not in app:
        sys.exit("Import viaggi in App.tsx non riconosciuto")
    app = app.replace(old, "applyCostToTrip, encodeTripBundle, isTripContent", 1)
if "mergeTripsIntoRoute" not in app:
    old = "isTripContent, parseTrips"
    if old not in app:
        sys.exit("Import parseTrips non trovato")
    app = app.replace(old, "isTripContent, mergeTripsIntoRoute, parseTrips", 1)
if "tripDurationSeconds" not in app:
    old = "mergeTripsIntoRoute, parseTrips"
    if old not in app:
        sys.exit("Import unione percorsi non trovato")
    app = app.replace(old, "mergeTripsIntoRoute, parseTrips, tripDistanceMeters, tripDurationSeconds", 1)
if "chargedDistanceMeters" not in app:
    old = "tripDistanceMeters, tripDurationSeconds"
    if old not in app:
        sys.exit("Import distanze non trovato")
    app = app.replace(old, "chargedDistanceMeters, chargedDurationSeconds, tripDistanceMeters, tripDurationSeconds", 1)
if "const [shownTripIds, setShownTripIds]" not in app:
    state = "const [selectedNote, setSelectedNote] = useState<Note | null>(null);"
    if state not in app:
        sys.exit("Stato nota non trovato in App.tsx")
    app = app.replace(state, state + "\n  const [shownTripIds, setShownTripIds] = useState<string[]>([]);\n  const tripSaveTimers = useRef<Record<string, number>>({});", 1)
app = app.replace("\n  const [openTripId, setOpenTripId] = useState<string | null>(null);", "")
app = app.replace("    setOpenTripId(trip.id);\n", "")
app = app.replace(" focusTripId={openTripId ?? undefined}", "")

merge = '''  const mergeArchiveTrips = async (chosen: ArchiveTrip[]) => {
    if (chosen.length < 2) return;
    try {
      for (const id of new Set(chosen.map((trip) => trip.sourceNote.id))) {
        if (tripSaveTimers.current[id]) window.clearTimeout(tripSaveTimers.current[id]);
      }
      const ordered = chosen.slice().sort((a, b) => a.startedAt - b.startedAt);
      const host = ordered[0];
      const plain = ordered.map((trip) => {
        const clean = { ...trip } as TripRecord & { sourceNote?: unknown };
        delete clean.sourceNote;
        return clean;
      });
      const distance = plain.reduce((sum, trip) => sum + chargedDistanceMeters(trip), 0);
      const duration = plain.reduce((sum, trip) => sum + chargedDurationSeconds(trip), 0);
      const legs = plain.flatMap((trip) => (trip.legs && trip.legs.length ? trip.legs : [trip]));
      const merged = {
        ...mergeTripsIntoRoute(plain),
        noteId: host.sourceNote.id,
        practiceId: host.practiceId,
        practiceName: host.practiceName,
        manualDistanceMeters: distance > 0 ? distance : null,
        manualDurationSeconds: duration > 0 ? duration : null,
        roundTrip: false,
        legs,
        note: [`Percorso unito da ${plain.length} viaggi. Km e tempo sono la somma.`, ...plain.map((trip) => trip.note.trim()).filter(Boolean)].join("\\n"),
      };
      delete (merged as TripRecord & { sourceNote?: unknown }).sourceNote;
      const ids = new Set(chosen.map((trip) => trip.id));
      const updates = [...new Map(ordered.map((trip) => {
        const note = notes.find((item) => item.id === trip.sourceNote.id) ?? trip.sourceNote;
        return [note.id, note] as const;
      })).values()].map((note) => {
        const remaining = parseTrips(note.content).filter((item) => !ids.has(item.id));
        const next = note.id === host.sourceNote.id ? [...remaining, merged] : remaining;
        const content = encodeTripBundle(next);
        return { ...note, content, preview: tripBundlePreview(content) };
      });
      setNotes((items) => items.map((item) => updates.find((next) => next.id === item.id) ?? item));
      setSelectedNote((current) => updates.find((next) => next.id === current?.id) ?? current);
      setShownTripIds([merged.id]);
      for (const next of updates) await saveNote(next);
    } catch (error) {
      window.alert(`Unione non riuscita.\\n${error instanceof Error ? error.message : String(error)}`);
    }
  };

'''
merge_pat = re.compile(r"  const mergeArchiveTrips = async \(chosen: ArchiveTrip\[\]\) => \{.*?\n  \};\n", re.S)
if merge_pat.search(app):
    app = merge_pat.sub(lambda _match: merge, app, count=1)
else:
    anchor = "  const openPrints = async () => {"
    if anchor not in app:
        sys.exit("openPrints non trovato in App.tsx")
    app = app.replace(anchor, merge + anchor, 1)

save = '''  const saveShownTrip = (trip: ArchiveTrip, updated: TripRecord) => {
    const source = notes.find((item) => item.id === trip.sourceNote.id) ?? trip.sourceNote;
    const clean = { ...updated } as TripRecord & { sourceNote?: unknown };
    delete clean.sourceNote;
    const next = parseTrips(source.content).map((item) => item.id === clean.id ? applyCostToTrip({ ...item, ...clean, id: item.id }) : item);
    const content = encodeTripBundle(next);
    const changed = { ...source, content, preview: tripBundlePreview(content) };
    lastLocalEditAt.current = Date.now();
    setNotes((items) => items.map((item) => item.id === changed.id ? changed : item));
    setSelectedNote((current) => current?.id === changed.id ? changed : current);
    if (tripSaveTimers.current[changed.id]) window.clearTimeout(tripSaveTimers.current[changed.id]);
    tripSaveTimers.current[changed.id] = window.setTimeout(() => { void saveNote(changed); }, 450);
  };

'''
save_pat = re.compile(r"  const saveShownTrip = \(trip: ArchiveTrip, updated: TripRecord\) => \{.*?\n  \};\n", re.S)
if save_pat.search(app):
    app = save_pat.sub(lambda _match: save, app, count=1)
else:
    anchor = "  const mergeArchiveTrips = async (chosen: ArchiveTrip[]) => {"
    if anchor not in app:
        sys.exit("Unione viaggi non inserita")
    app = app.replace(anchor, save + anchor, 1)

split = '''  const splitArchiveTrip = async (trip: ArchiveTrip) => {
    const legs = (trip.legs ?? []).filter((leg) => leg && leg.id && leg.id !== trip.id);
    if (legs.length < 2) return;
    try {
      if (tripSaveTimers.current[trip.sourceNote.id]) window.clearTimeout(tripSaveTimers.current[trip.sourceNote.id]);
      const host = notes.find((item) => item.id === trip.sourceNote.id) ?? trip.sourceNote;
      const noteById = new Map(notes.map((item) => [item.id, item] as const));
      const targetId = (leg: TripRecord) => leg.noteId && noteById.has(leg.noteId) ? leg.noteId! : host.id;
      const groups = new Map<string, TripRecord[]>();
      for (const leg of legs) {
        const id = targetId(leg);
        groups.set(id, [...(groups.get(id) ?? []), leg]);
      }
      if (!groups.has(host.id)) groups.set(host.id, []);
      const updates = [...groups.entries()].map(([id, restored]) => {
        const note = noteById.get(id) ?? host;
        const restoredIds = new Set(restored.map((leg) => leg.id));
        const kept = parseTrips(note.content).filter((item) => item.id !== trip.id && !restoredIds.has(item.id));
        const next = [...kept, ...restored.map((leg) => ({ ...leg, noteId: id }))];
        const content = encodeTripBundle(next);
        return { ...note, content, preview: tripBundlePreview(content) };
      });
      setNotes((items) => items.map((item) => updates.find((next) => next.id === item.id) ?? item));
      setSelectedNote((current) => updates.find((next) => next.id === current?.id) ?? current);
      setShownTripIds(legs.map((leg) => leg.id));
      for (const next of updates) await saveNote(next);
    } catch (error) {
      window.alert(`Separazione non riuscita.\\n${error instanceof Error ? error.message : String(error)}`);
    }
  };

'''
split_pat = re.compile(r"  const splitArchiveTrip = async \(trip: ArchiveTrip\) => \{.*?\n  \};\n", re.S)
if split_pat.search(app):
    app = split_pat.sub(lambda _match: split, app, count=1)
else:
    anchor = "  const mergeArchiveTrips = async (chosen: ArchiveTrip[]) => {"
    if anchor not in app:
        anchor = "  const openPrints = async () => {"
    if anchor not in app:
        sys.exit("Punto di inserimento separazione non trovato")
    app = app.replace(anchor, split + anchor, 1)

nav_trips = '<button className={view === "trips" ? "active" : ""} onClick={() => chooseView("trips")}><Car size={17}/>Archivio Viaggi</button>'
nav_assigned = '<button className={view === "assigned" ? "active" : ""} onClick={() => chooseView("assigned")}><Archive size={17}/>Viaggi Assegnati</button>'
nav_private = '<button className={view === "private" ? "active" : ""} onClick={() => chooseView("private")}><LockKeyhole size={17}/>Viaggi privati</button>'
if "Viaggi Assegnati</button>" not in app:
    if nav_trips not in app:
        sys.exit("Voce Archivio Viaggi non trovata")
    app = app.replace(nav_trips, nav_trips + "\n        " + nav_assigned, 1)
if "Viaggi privati</button>" not in app:
    if nav_assigned not in app:
        sys.exit("Voce Viaggi Assegnati non trovata")
    app = app.replace(nav_assigned, nav_assigned + "\n        " + nav_private, 1)

title_trips = 'if (view === "trips") return "Archivio Viaggi";'
title_assigned = 'if (view === "assigned") return "Viaggi Assegnati";'
title_private = 'if (view === "private") return "Viaggi privati";'
if title_assigned not in app:
    if title_trips not in app:
        sys.exit("Titolo archivio viaggi non trovato")
    app = app.replace(title_trips, title_trips + "\n    " + title_assigned, 1)
if title_private not in app:
    if title_assigned not in app:
        sys.exit("Titolo viaggi assegnati non trovato")
    app = app.replace(title_assigned, title_assigned + "\n    " + title_private, 1)

refresh_old = """    const listView = view === "trips" ? "all" : view;
    const result = await listNotes(view === "trips" ? null : selectedNotebook, listView, query);
    setNotes(result);
    if (view === "trips") return;"""
refresh_assigned = 'const tripArchive = view === "trips" || view === "assigned";'
refresh_full = 'const tripArchive = view === "trips" || view === "assigned" || view === "private";'
if refresh_full not in app:
    if refresh_assigned in app:
        app = app.replace(refresh_assigned, refresh_full, 1)
    elif refresh_old in app:
        refresh_new = """    const tripArchive = view === "trips" || view === "assigned" || view === "private";
    const listView = tripArchive ? "all" : view;
    const result = await listNotes(tripArchive ? null : selectedNotebook, listView, query);
    setNotes(result);
    if (tripArchive) return;"""
        app = app.replace(refresh_old, refresh_new, 1)
    else:
        sys.exit("Aggiornamento elenco note non trovato")

if "Data del viaggio" not in app:
    app = app.replace("<span>Titolo</span>", '<span>{view === "trips" || view === "assigned" || view === "private" ? "Percorso" : "Titolo"}</span>', 1)
    app = app.replace("<span>Data aggiornamento</span>", '<span>{view === "trips" || view === "assigned" || view === "private" ? "Data del viaggio" : "Data aggiornamento"}</span>', 1)
    app = app.replace("<span>Data creazione</span>", '<span>{view === "trips" || view === "assigned" || view === "private" ? "Data della nota" : "Data creazione"}</span>', 1)

app = re.sub(
    r'view === "trips" \|\| view === "assigned"(?! \|\| view === "private")',
    'view === "trips" || view === "assigned" || view === "private"',
    app,
)

types_path = root / "src" / "types.ts"
