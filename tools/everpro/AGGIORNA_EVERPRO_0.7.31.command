echo ""
echo "Compilo EverPro desktop. Può volerci un po'."
if [[ -f "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
fi
cd "$PROJ"
LOG="$HOME/Desktop/everpro-desktop-percorso.log"
npm run tauri build -- --bundles app >"$LOG" 2>&1 &
XPID=$!
while kill -0 "$XPID" >/dev/null 2>&1; do
  sleep 12
  LINE=$(tail -1 "$LOG" 2>/dev/null || true)
  echo "… ${LINE:0:140}"
done
wait "$XPID"
BUILD_OK=$?
if [[ "$BUILD_OK" -ne 0 ]]; then
  echo "COMPILAZIONE FALLITA."
  tail -40 "$LOG"
  echo "Log: $LOG"
  exit 1
fi

APP=$(find "$PROJ/src-tauri/target/release/bundle/macos" -name 'EverPro.app' -type d 2>/dev/null | head -1)
if [[ -z "$APP" ]]; then
  APP=$(find "$PROJ/src-tauri/target" -name 'EverPro.app' -type d -path '*release/bundle/macos/*' 2>/dev/null | head -1)
fi
echo ""
echo "FATTO."
if [[ -n "$APP" ]]; then
  osascript -e 'quit app "EverPro"' >/dev/null 2>&1 || true
  sleep 1
  rm -rf "/Applications/EverPro.app"
  ditto "$APP" "/Applications/EverPro.app"
  echo "EverPro è in Applicazioni. Lo apro."
  open "/Applications/EverPro.app"
else
  echo "App compilata. Cercala in $PROJ/src-tauri/target/release/bundle/macos"
  open "$PROJ/src-tauri/target/release/bundle/macos"
fi
echo "In alto a sinistra deve comparire 0.7.31."
echo "Nella pratica la trasferta si legge come percorso, non come codice."
echo "I chilometri sono quelli del percorso registrato dall'iPhone."
echo "Su un viaggio assegnato si vede la pratica e si può cambiare."
echo "I viaggi a 0 km non vengono registrati."
echo "Andata e ritorno raddoppia km, tempo e totale, e la scheda mostra anche il percorso di andata."
