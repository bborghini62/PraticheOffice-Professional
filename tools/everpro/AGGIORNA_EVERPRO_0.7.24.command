#!/bin/zsh
set -u
echo ""
echo "============================================"
echo " QUESTO È IL FILE NUOVO — EverPro desktop 0.7.24"
echo "============================================"
echo "Script: $0"
echo ""

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "ERRORE: va lanciato sul Mac."
  exit 1
fi

PATCH="$HOME/Desktop/everpro-sorgenti-0.7.24"
mkdir -p "$PATCH"
python3 - "$PATCH" << 'PY'
import base64, sys
from pathlib import Path
root = Path(sys.argv[1])
files = {
    "TripArchive.tsx": "",
    "SelectedTrips.tsx": "",
    "openExternal.ts": "",
    "AssignPractice.tsx": "",
    "TripEditor.tsx": "",
}
for name, payload in files.items():
    path = root / name
    path.write_bytes(base64.b64decode(payload))
    print(f"Scritto {path}")
PY
if ! grep -q "Percorso unito" "$PATCH/TripArchive.tsx" || ! grep -q "Scopi privati" "$PATCH/SelectedTrips.tsx"; then
  echo "ERRORE: i sorgenti del 0.7.24 non sono completi."
  exit 1
fi

echo "File giusti: niente cerca pratica a sinistra, percorso unito e scopi privati."

PROJ=$(python3 - <<'PY'
import json
from pathlib import Path
best = None
best_key = ()
root = Path("/Volumes/Disco_Dati/Evernote")
if not root.exists():
    raise SystemExit(0)
for candidate in root.glob("EverPro-Desktop-*"):
    needed = [candidate / "src/App.tsx", candidate / "src/trips.ts", candidate / "src/TripArchive.tsx", candidate / "package.json"]
    if not all(path.is_file() for path in needed):
        continue
    version = json.loads((candidate / "package.json").read_text()).get("version", "0")
    print(f"Trovato {candidate} ({version})", file=__import__("sys").stderr)
    key = tuple(int(part) if part.isdigit() else 0 for part in str(version).split("."))
    if key >= best_key:
        best_key = key
        best = candidate
if best:
    print(best)
PY
)
if [[ -z "$PROJ" ]]; then
  echo "ERRORE: non trovo EverPro desktop su Disco_Dati."
  exit 1
fi
echo "Aggiorno: $PROJ"
echo ""

cp -p "$PATCH/TripArchive.tsx" "$PROJ/src/TripArchive.tsx"
if grep -q "AssignPractice" "$PROJ/src/TripArchive.tsx"; then
  echo "ERRORE: l'archivio ha ancora Cerca pratica su ogni viaggio. Non compilo."
  exit 1
fi
cp -p "$PATCH/SelectedTrips.tsx" "$PROJ/src/SelectedTrips.tsx"
cp -p "$PATCH/openExternal.ts" "$PROJ/src/openExternal.ts"
cp -p "$PATCH/AssignPractice.tsx" "$PROJ/src/AssignPractice.tsx"
if [[ -f "$PATCH/TripEditor.tsx" ]]; then
  cp -p "$PATCH/TripEditor.tsx" "$PROJ/src/TripEditor.tsx"
fi
echo "Aggiornati elenco viaggi e pannello a destra."

python3 - "$PROJ/src/trips.ts" "$PROJ/src/App.tsx" "$PROJ" <<'PY'
import json, re, sys
from pathlib import Path
trips_path, app_path, root = Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3])
trips = trips_path.read_text()
broken_join = '.join("' + "\n" + '")'
fixed_join = '.join("\\n")'
trips = trips.replace(broken_join, fixed_join)
field = "manualDistanceMeters?: number | null;"
if "manualDurationSeconds?" not in trips:
    if field not in trips:
        sys.exit("Campo chilometri non trovato")
    trips = trips.replace(field, field + "\n  manualDurationSeconds?: number | null;", 1)
if "privateUse?" not in trips:
    if "manualDurationSeconds?: number | null;" not in trips:
        sys.exit("Campo tempo non trovato")
    trips = trips.replace("manualDurationSeconds?: number | null;", "manualDurationSeconds?: number | null;\n  privateUse?: boolean | null;\n  legs?: TripRecord[] | null;", 1)
old_duration = """export const tripDurationSeconds = (trip: TripRecord) => {
  const end = trip.endedAt ?? Date.now();
  return Math.max(0, Math.round((end - trip.startedAt) / 1000));
};"""
new_duration = """export const tripDurationSeconds = (trip: TripRecord) => {
  if (trip.manualDurationSeconds && trip.manualDurationSeconds > 0) return Math.round(trip.manualDurationSeconds);
  const end = trip.endedAt ?? Date.now();
  return Math.max(0, Math.round((end - trip.startedAt) / 1000));
};"""
if old_duration in trips:
    trips = trips.replace(old_duration, new_duration, 1)
elif "trip.manualDurationSeconds && trip.manualDurationSeconds > 0" not in trips:
    sys.exit("Calcolo tempo non trovato")
merge_fn = '''export const mergeTripsIntoRoute = (trips: TripRecord[]): TripRecord => {
  const ordered = trips.slice().sort((a, b) => a.startedAt - b.startedAt);
  const first = ordered[0];
  const last = ordered[ordered.length - 1];
  const points = ordered.flatMap((trip) => trip.points ?? []).filter((point) => Number.isFinite(point.lat) && Number.isFinite(point.lon)).sort((a, b) => a.t - b.t);
  const notes = ordered.map((trip) => trip.note.trim()).filter(Boolean);
  const distance = ordered.reduce((sum, trip) => sum + tripDistanceMeters(trip), 0);
  const duration = ordered.reduce((sum, trip) => sum + tripDurationSeconds(trip), 0);
  return applyCostToTrip({
    ...first,
    id: crypto.randomUUID(),
    endedAt: last.endedAt ?? last.startedAt,
    endAddress: last.endAddress,
    endPlace: last.endPlace ?? first.endPlace ?? null,
    endLat: last.endLat ?? null,
    endLon: last.endLon ?? null,
    points,
    note: [`Percorso unito da ${ordered.length} viaggi.`, ...notes].join("\\n"),
    manualDistanceMeters: distance > 0 ? distance : null,
    manualDurationSeconds: duration > 0 ? duration : null,
  });
};

'''
merge_fn_pat = re.compile(r"export const mergeTripsIntoRoute = \(trips: TripRecord\[\]\): TripRecord => \{.*?\n\};\n\n", re.S)
if merge_fn_pat.search(trips):
    trips = merge_fn_pat.sub(lambda _match: merge_fn, trips, count=1)
elif "export const mapsUrl" in trips:
    trips = trips.replace("export const mapsUrl", merge_fn + "export const mapsUrl", 1)
else:
    sys.exit("Nel file viaggi manca mapsUrl")
trips_path.write_text(trips)
print("Unione percorsi: somma km e tempo.")

app = app_path.read_text()
app = app.replace(broken_join, fixed_join)
if 'from "./SelectedTrips"' not in app:
    anchor = 'import TripArchive, { collectArchiveTrips, type ArchiveTrip } from "./TripArchive";\n'
    if anchor not in app:
        sys.exit("Import archivio non trovato in App.tsx")
    app = app.replace(anchor, anchor + 'import SelectedTrips from "./SelectedTrips";\n', 1)
if "applyCostToTrip" not in app:
    old = "encodeTripBundle, isTripContent"
    if old not in app:
        sys.exit("Import viaggi in App.tsx non riconosciuto")
    app = app.replace(old, "applyCostToTrip, encodeTripBundle, isTripContent", 1)
if "mergeTripsIntoRoute" not in app:
    old = "isTripContent, parseTrips"
    if old not in app:
        sys.exit("Import parseTrips non trovato")
    app = app.replace(old, "isTripContent, mergeTripsIntoRoute, parseTrips", 1)
if "tripDurationSeconds" not in app:
    old = "mergeTripsIntoRoute, parseTrips"
    if old not in app:
        sys.exit("Import unione percorsi non trovato")
    app = app.replace(old, "mergeTripsIntoRoute, parseTrips, tripDistanceMeters, tripDurationSeconds", 1)
if "const [shownTripIds, setShownTripIds]" not in app:
    state = "const [selectedNote, setSelectedNote] = useState<Note | null>(null);"
    if state not in app:
        sys.exit("Stato nota non trovato in App.tsx")
    app = app.replace(state, state + "\n  const [shownTripIds, setShownTripIds] = useState<string[]>([]);\n  const tripSaveTimers = useRef<Record<string, number>>({});", 1)
app = app.replace("\n  const [openTripId, setOpenTripId] = useState<string | null>(null);", "")
app = app.replace("    setOpenTripId(trip.id);\n", "")
app = app.replace(" focusTripId={openTripId ?? undefined}", "")

merge = '''  const mergeArchiveTrips = async (chosen: ArchiveTrip[]) => {
    if (chosen.length < 2) return;
    try {
      for (const id of new Set(chosen.map((trip) => trip.sourceNote.id))) {
        if (tripSaveTimers.current[id]) window.clearTimeout(tripSaveTimers.current[id]);
      }
      const ordered = chosen.slice().sort((a, b) => a.startedAt - b.startedAt);
      const host = ordered[0];
      const plain = ordered.map((trip) => {
        const clean = { ...trip } as TripRecord & { sourceNote?: unknown };
        delete clean.sourceNote;
        return clean;
      });
      const distance = plain.reduce((sum, trip) => sum + tripDistanceMeters(trip), 0);
      const duration = plain.reduce((sum, trip) => sum + tripDurationSeconds(trip), 0);
      const legs = plain.flatMap((trip) => (trip.legs && trip.legs.length ? trip.legs : [trip]));
      const merged = {
        ...mergeTripsIntoRoute(plain),
        noteId: host.sourceNote.id,
        practiceId: host.practiceId,
        practiceName: host.practiceName,
        manualDistanceMeters: distance > 0 ? distance : null,
        manualDurationSeconds: duration > 0 ? duration : null,
        legs,
        note: [`Percorso unito da ${plain.length} viaggi. Km e tempo sono la somma.`, ...plain.map((trip) => trip.note.trim()).filter(Boolean)].join("\\n"),
      };
      delete (merged as TripRecord & { sourceNote?: unknown }).sourceNote;
      const ids = new Set(chosen.map((trip) => trip.id));
      const updates = [...new Map(ordered.map((trip) => {
        const note = notes.find((item) => item.id === trip.sourceNote.id) ?? trip.sourceNote;
        return [note.id, note] as const;
      })).values()].map((note) => {
        const remaining = parseTrips(note.content).filter((item) => !ids.has(item.id));
        const next = note.id === host.sourceNote.id ? [...remaining, merged] : remaining;
        const content = encodeTripBundle(next);
        return { ...note, content, preview: tripBundlePreview(content) };
      });
      setNotes((items) => items.map((item) => updates.find((next) => next.id === item.id) ?? item));
      setSelectedNote((current) => updates.find((next) => next.id === current?.id) ?? current);
      setShownTripIds([merged.id]);
      for (const next of updates) await saveNote(next);
    } catch (error) {
      window.alert(`Unione non riuscita.\\n${error instanceof Error ? error.message : String(error)}`);
    }
  };

'''
merge_pat = re.compile(r"  const mergeArchiveTrips = async \(chosen: ArchiveTrip\[\]\) => \{.*?\n  \};\n", re.S)
if merge_pat.search(app):
    app = merge_pat.sub(lambda _match: merge, app, count=1)
else:
    anchor = "  const openPrints = async () => {"
    if anchor not in app:
        sys.exit("openPrints non trovato in App.tsx")
    app = app.replace(anchor, merge + anchor, 1)

save = '''  const saveShownTrip = (trip: ArchiveTrip, updated: TripRecord) => {
    const source = notes.find((item) => item.id === trip.sourceNote.id) ?? trip.sourceNote;
    const clean = { ...updated } as TripRecord & { sourceNote?: unknown };
    delete clean.sourceNote;
    const next = parseTrips(source.content).map((item) => item.id === clean.id ? applyCostToTrip({ ...item, ...clean, id: item.id }) : item);
    const content = encodeTripBundle(next);
    const changed = { ...source, content, preview: tripBundlePreview(content) };
    lastLocalEditAt.current = Date.now();
    setNotes((items) => items.map((item) => item.id === changed.id ? changed : item));
    setSelectedNote((current) => current?.id === changed.id ? changed : current);
    if (tripSaveTimers.current[changed.id]) window.clearTimeout(tripSaveTimers.current[changed.id]);
    tripSaveTimers.current[changed.id] = window.setTimeout(() => { void saveNote(changed); }, 450);
  };

'''
save_pat = re.compile(r"  const saveShownTrip = \(trip: ArchiveTrip, updated: TripRecord\) => \{.*?\n  \};\n", re.S)
if save_pat.search(app):
    app = save_pat.sub(lambda _match: save, app, count=1)
else:
    anchor = "  const mergeArchiveTrips = async (chosen: ArchiveTrip[]) => {"
    if anchor not in app:
        sys.exit("Unione viaggi non inserita")
    app = app.replace(anchor, save + anchor, 1)

archive = '{view === "trips" ? <TripArchive trips={archiveTrips} query={query} onOpen={(trip) => setShownTripIds([trip.id])} onSelection={(chosen) => setShownTripIds(chosen.map((item) => item.id))} onDelete={(trip) => { setShownTripIds((ids) => ids.filter((id) => id !== trip.id)); void deleteArchiveTrip(trip); }}/> : '
archive_pat = re.compile(r'\{view === "trips" \? <TripArchive\b.*?\/> : ', re.S)
if not archive_pat.search(app):
    sys.exit("Elenco archivio viaggi non trovato")
app = archive_pat.sub(lambda _match: archive, app, count=1)

selected = '{view === "trips" ? <SelectedTrips trips={archiveTrips.filter((trip) => shownTripIds.includes(trip.id))} notebooks={notebooks} onChange={(trip, updated) => saveShownTrip(trip, updated)} onAssign={(trip, notebookId) => void assignTripToPractice(trip, notebookId, trip.sourceNote)} onDelete={(trip) => { setShownTripIds((ids) => ids.filter((id) => id !== trip.id)); void deleteArchiveTrip(trip); }} onMerge={(chosen) => void mergeArchiveTrips(chosen)}/> : '
selected_pat = re.compile(r'\{view === "trips" \? <SelectedTrips\b.*?\/> : ', re.S)
if selected_pat.search(app):
    app = selected_pat.sub(lambda _match: selected, app, count=1)
else:
    needle = "{selectedNote ? <>"
    if needle not in app:
        sys.exit("Finestra a destra non trovata")
    app = app.replace(needle, selected + "selectedNote ? <>", 1)

main_new = '<main className="editor" style={view === "trips" ? { position: "relative", height: "100%", minHeight: "100%", overflow: "hidden" } : undefined}>'
for main_old in (
    '<main className="editor" style={view === "trips" ? { position: "relative", minHeight: 0, height: "100%", overflow: "hidden" } : undefined}>',
    '<main className="editor">',
):
    if main_old in app:
        app = app.replace(main_old, main_new, 1)
        break
else:
    if main_new not in app:
        sys.exit("Finestra editor non trovata")

app = re.sub(r"(EverPro <small>)[^<]*(</small>)", r"\g<1>0.7.24\2", app, count=1)
app_path.write_text(app)
print("A destra restano solo i viaggi selezionati, con la mappa.")

def bump(path: Path, pattern: str) -> None:
    if not path.is_file():
        return
    text = path.read_text()
    updated, count = re.subn(pattern, r"\g<1>0.7.24\2", text, count=1)
    if count:
        path.write_text(updated)
        print(f"Versione 0.7.24 in {path.name}")

bump(root / "package.json", r'("version"\s*:\s*")[^"]*(")')
bump(root / "src-tauri" / "tauri.conf.json", r'("version"\s*:\s*")[^"]*(")')
bump(root / "src-tauri" / "Cargo.toml", r'(?m)^(version\s*=\s*")[^"]*(")')

rust_files = list((root / "src-tauri" / "src").glob("*.rs")) if (root / "src-tauri" / "src").is_dir() else []
rust_target = next((path for path in rust_files if "generate_handler!" in path.read_text()), None)
if rust_target is None:
    sys.exit("Non trovo il comando Tauri: Google Maps non può aprirsi.")
rust = rust_target.read_text()
if "fn open_external" not in rust:
    command = '''
#[tauri::command]
fn open_external(url: String) -> Result<(), String> {
    if !(url.starts_with("https://www.google.com/maps") || url.starts_with("https://maps.google.com/")) {
        return Err("Si può aprire solo un percorso di Google Maps.".into());
    }
    std::process::Command::new("open").arg(url).spawn().map_err(|error| error.to_string())?;
    Ok(())
}

'''
    uses = list(re.finditer(r"(?m)^use .*;\n", rust))
    at = uses[-1].end() if uses else 0
    rust = rust[:at] + command + rust[at:]

def add_open_external(match: re.Match[str]) -> str:
    body = match.group(2)
    if re.search(r"\bopen_external\b", body):
        return match.group(0)
    stripped = body.rstrip()
    if not stripped:
        return match.group(1) + "open_external" + match.group(3)
    if not stripped.endswith(","):
        stripped += ","
    return match.group(1) + stripped + "\n    open_external,\n" + match.group(3)

rust2, wired = re.subn(r"(tauri::generate_handler!\[)(.*?)(\])", add_open_external, rust, count=1, flags=re.S)
if not wired or "fn open_external" not in rust2 or not re.search(r"generate_handler!\[[^\]]*open_external", rust2, re.S):
    sys.exit("Non riesco a collegare l’apertura di Google Maps.")
rust_target.write_text(rust2)
print(f"Google Maps si apre dal browser di sistema ({rust_target.name}).")
PY
if [[ $? -ne 0 ]]; then
  echo "AGGIORNAMENTO FERMATO. Non compilo la versione precedente."
  exit 1
fi
if ! grep -q "0.7.24" "$PROJ/src/App.tsx"; then
  echo "ERRORE: nel programma è rimasta la versione vecchia. Non compilo."
  exit 1
fi

echo ""
echo "Compilo EverPro desktop. Può volerci un po'."
if [[ -f "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
fi
cd "$PROJ"
LOG="$HOME/Desktop/everpro-desktop-percorso.log"
npm run tauri build -- --bundles app >"$LOG" 2>&1 &
XPID=$!
while kill -0 "$XPID" >/dev/null 2>&1; do
  sleep 12
  LINE=$(tail -1 "$LOG" 2>/dev/null || true)
  echo "… ${LINE:0:140}"
done
wait "$XPID"
BUILD_OK=$?
if [[ "$BUILD_OK" -ne 0 ]]; then
  echo "COMPILAZIONE FALLITA."
  tail -40 "$LOG"
  echo "Log: $LOG"
  exit 1
fi

APP=$(find "$PROJ/src-tauri/target/release/bundle/macos" -name 'EverPro.app' -type d 2>/dev/null | head -1)
if [[ -z "$APP" ]]; then
  APP=$(find "$PROJ/src-tauri/target" -name 'EverPro.app' -type d -path '*release/bundle/macos/*' 2>/dev/null | head -1)
fi
echo ""
echo "FATTO."
if [[ -n "$APP" ]]; then
  osascript -e 'quit app "EverPro"' >/dev/null 2>&1 || true
  sleep 1
  rm -rf "/Applications/EverPro.app"
  ditto "$APP" "/Applications/EverPro.app"
  echo "EverPro è in Applicazioni. Lo apro."
  open "/Applications/EverPro.app"
else
  echo "App compilata. Cercala in $PROJ/src-tauri/target/release/bundle/macos"
  open "$PROJ/src-tauri/target/release/bundle/macos"
fi
echo "In alto a sinistra deve comparire 0.7.24."
echo "Il percorso unito sta nell’archivio a sinistra. Aprendolo si vedono i viaggi singoli."
echo "Scopi privati toglie Assegna a."
echo "In Assegna a si cerca la pratica scrivendo il nome."
echo "Unisci in un percorso apre una scheda nuova con km e tempo sommati."
echo "La finestra resta grande. A destra si scorre l’elenco dei viaggi, senza rimpicciolirli."
