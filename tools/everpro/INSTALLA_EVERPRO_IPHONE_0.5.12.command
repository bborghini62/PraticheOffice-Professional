for name, blob in files.items():
    data = base64.b64decode("".join(blob.split()))
    (root / name).write_bytes(data)
    print(f"Pronto {name} ({len(data)} byte)")
PY
if ! grep -q "func cardPreview" "$SRC/Views.swift" || ! grep -q "func repairTripNotes" "$SRC/ArchiveStore.swift" || ! grep -q "chargedDistanceMeters" "$SRC/TripTracker.swift" || ! grep -q "Cambia pratica" "$SRC/TripViews.swift" || ! grep -q "uploadV3(store.archive()" "$SRC/GoogleDriveSync.swift" || ! grep -q "PDF del giorno" "$SRC/TripReport.swift" || ! grep -q "Viaggi selezionati" "$SRC/TripReport.swift" || ! grep -q "Seleziona trasferta" "$SRC/TripViews.swift" || ! grep -q "Con percorso" "$SRC/TripViews.swift" || ! grep -q "drawRoute" "$SRC/TripReport.swift" || ! grep -q "func mainStops" "$SRC/TripReport.swift" || ! grep -q "Punti del percorso" "$SRC/TripReport.swift"; then
  echo "ERRORE: sorgenti 0.5.12 incompleti. Non compilo."
  exit 1
fi

echo "Chiudo Xcode, se è bloccato."
killall Xcode >/dev/null 2>&1 || true
sleep 2

SCRIPT_DIR="${0:A:h}"
for BAD in \
  "$SCRIPT_DIR/EverPro-iPhone-0.5.5/EverProiPhone.xcodeproj" \
  "$HOME/Library/Application Support/Cursor/AgentStores/cursor_agent_stores/bc-9c661085-c14f-5658-9e40-277104f564c0/files/docs/EverPro-iPhone-0.5.5/EverProiPhone.xcodeproj" \
  "$HOME/Library/Application Support/Cursor/AgentStores/cursor_agent_stores/bc-52305495-3635-481b-b71b-7737fe66e80f/files/docs/EverPro-iPhone-0.5.5/EverProiPhone.xcodeproj"
do
  if [[ -e "$BAD" ]]; then
    rm -rf "$BAD" 2>/dev/null || true
    echo "Tolto il progetto senza icona: $BAD"
  fi
done

PROJ="/Volumes/Disco_Dati/Evernote/EverPro-iPhone-0.5.1"
if [[ ! -d "$PROJ" ]]; then
  echo "ERRORE: disco non trovato: $PROJ"
  echo "Collega Disco_Dati e rilancia questa stessa riga."
  exit 1
fi

echo "Sorgenti: $SRC"
echo "Progetto vero: $PROJ"

copy_one() {
  local NAME="$1"
  local MARKER="$2"
  local DEST=""
  local FILE
  while IFS= read -r FILE; do
    [[ -z "$FILE" ]] && continue
    if grep -q "$MARKER" "$FILE"; then
      DEST="$FILE"
      break
    fi
  done < <(find "$PROJ" -name "$NAME" -type f ! -path '*/.*' ! -name '*.bak-prima-di-0.5.5' 2>/dev/null)
  if [[ -z "$DEST" ]]; then
    echo "ERRORE: nel progetto vero non c'è $NAME"
    exit 1
  fi
  if [[ ! -f "$DEST.bak-prima-di-0.5.5" ]]; then
    cp -p "$DEST" "$DEST.bak-prima-di-0.5.5"
  fi
  cp -p "$SRC/$NAME" "$DEST"
  echo "Aggiornato $NAME"
}

copy_one "Views.swift" "Autorizza Google Drive"
copy_one "TripTracker.swift" "considerAutoStop"
copy_one "TripViews.swift" "Rilevamento automatico"
copy_one "ArchiveStore.swift" "func assignTrip"
copy_one "GoogleDriveSync.swift" "Allineamento con il Mac"
copy_one "TripReport.swift" "PDF del giorno"

PBX=""
while IFS= read -r FILE; do
  [[ -z "$FILE" ]] && continue
  case "$FILE" in
    *conflict*|*/EverPro-iPhone-0.5.5/*) continue ;;
    */EverProiPhone.xcodeproj/project.pbxproj) PBX="$FILE"; break ;;
  esac
done < <(find "$PROJ" -name project.pbxproj -type f ! -path '*/.*' 2>/dev/null)
if [[ -z "$PBX" ]]; then
  echo "ERRORE: project.pbxproj non trovato nel progetto vero."
  exit 1
fi
if [[ ! -f "$PBX.bak-prima-di-0.5.5" ]]; then
  cp -p "$PBX" "$PBX.bak-prima-di-0.5.5"
fi
perl -i -pe 's/MARKETING_VERSION = [^;]+;/MARKETING_VERSION = 0.5.12;/g; s/CURRENT_PROJECT_VERSION = [^;]+;/CURRENT_PROJECT_VERSION = 0.5.12;/g' "$PBX"
echo "Versione impostata a 0.5.12"
echo "Progetto: $PBX"

XCODEPROJ="${PBX:h}"
case "$XCODEPROJ" in
  *.xcodeproj) ;;
  *)
    echo "ERRORE: percorso progetto inatteso: $XCODEPROJ"
    exit 1
    ;;
esac
case "$XCODEPROJ" in
  *AgentStores*|*EverPro-iPhone-0.5.5*)
    echo "ERRORE: stavo per compilare la copia senza icona. Mi fermo."
    exit 1
    ;;
esac
if [[ -d "$PROJ/xcshareddata" ]]; then
  rm -rf "$PROJ/xcshareddata"
fi

if [[ -d /Applications/Xcode.app/Contents/Developer ]]; then
  export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
fi
if ! command -v xcodebuild >/dev/null 2>&1; then
  echo "ERRORE: xcodebuild non trovato. Apri Xcode una volta dal Launchpad e rilancia."
  exit 1
fi

SCHEME=""
EXISTING=$(find "$XCODEPROJ/xcshareddata/xcschemes" -name '*.xcscheme' -type f ! -path '*conflict*' 2>/dev/null | head -1)
if [[ -n "$EXISTING" ]]; then
  SCHEME="${EXISTING:t:r}"
  echo "Scheme già presente: $SCHEME"
fi
if [[ -z "$SCHEME" ]]; then
  LIST_JSON=$(xcodebuild -project "$XCODEPROJ" -list -json 2>/dev/null || true)
  SCHEME=$(python3 -c 'import json,sys
raw=sys.stdin.read().strip()
start=raw.find("{")
if start<0:
    sys.exit(0)
data=json.loads(raw[start:])
proj=data.get("project") or data.get("workspace") or {}
schemes=proj.get("schemes") or []
print(schemes[0] if schemes else "")' <<<"$LIST_JSON")
fi
if [[ -z "$SCHEME" ]]; then
  echo "Nessuno scheme condiviso. Lo creo adesso."
  SCHEME=$(python3 - "$PBX" "$XCODEPROJ" <<'PY'
import re, sys, pathlib
pbx, xcodeproj = sys.argv[1], sys.argv[2]
text = pathlib.Path(pbx).read_text(errors="replace")
found = []
for m in re.finditer(r'([A-F0-9]{24}) /\* ([^*]+) \*/ = \{\s*isa = PBXNativeTarget;(.*?)\n\t\t\};', text, re.S):
    body = m.group(3)
    if "com.apple.product-type.application" not in body:
        continue
    prod = re.search(r'productReference = [A-F0-9]{24} /\* (.+?) \*/', body)
    name = m.group(2).strip()
    product = prod.group(1) if prod else name + ".app"
    found.append((m.group(1), name, product))
if not found:
    sys.exit("Nessun target applicazione nel progetto")
uid, name, product = next((item for item in found if item[1] == "EverPro"), found[0])
container = "container:" + pathlib.Path(xcodeproj).name
scheme_dir = pathlib.Path(xcodeproj) / "xcshareddata" / "xcschemes"
scheme_dir.mkdir(parents=True, exist_ok=True)
ref = f'''               BuildableIdentifier = "primary"
               BlueprintIdentifier = "{uid}"
               BuildableName = "{product}"
               BlueprintName = "{name}"
               ReferencedContainer = "{container}"'''
xml = f'''<?xml version="1.0" encoding="UTF-8"?>
<Scheme LastUpgradeVersion = "1500" version = "1.7">
   <BuildAction parallelizeBuildables = "YES" buildImplicitDependencies = "YES">
      <BuildActionEntries>
         <BuildActionEntry buildForTesting = "YES" buildForRunning = "YES" buildForProfiling = "YES" buildForArchiving = "YES" buildForAnalyzing = "YES">
            <BuildableReference
{ref}>
            </BuildableReference>
         </BuildActionEntry>
      </BuildActionEntries>
   </BuildAction>
   <TestAction buildConfiguration = "Debug" selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB" selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB" shouldUseLaunchSchemeArgsEnv = "YES"></TestAction>
   <LaunchAction buildConfiguration = "Debug" selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB" selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB" launchStyle = "0" useCustomWorkingDirectory = "NO" ignoresPersistentStateOnLaunch = "NO" debugDocumentVersioning = "YES" debugServiceExtension = "internal" allowLocationSimulation = "YES">
      <BuildableProductRunnable runnableDebuggingMode = "0">
         <BuildableReference
{ref}>
         </BuildableReference>
      </BuildableProductRunnable>
   </LaunchAction>
   <ProfileAction buildConfiguration = "Release" shouldUseLaunchSchemeArgsEnv = "YES" savedToolIdentifier = "" useCustomWorkingDirectory = "NO" debugDocumentVersioning = "YES">
      <BuildableProductRunnable runnableDebuggingMode = "0">
         <BuildableReference
{ref}>
         </BuildableReference>
      </BuildableProductRunnable>
   </ProfileAction>
   <AnalyzeAction buildConfiguration = "Debug"></AnalyzeAction>
   <ArchiveAction buildConfiguration = "Release" revealArchiveInOrganizer = "YES"></ArchiveAction>
</Scheme>
'''
path = scheme_dir / f"{name}.xcscheme"
path.write_text(xml)
print(name)
PY
)
  if [[ -z "$SCHEME" ]]; then
    echo "ERRORE: non sono riuscito a creare lo scheme."
    exit 1
  fi
  echo "Scheme creato: $SCHEME"
fi
echo "Scheme: $SCHEME"

echo "Cerco l'iPhone collegato. Tienilo sbloccato."
DEST_LOG="$HOME/Desktop/everpro-0.5.5-destinations.txt"
UDID=""
for TRY in 1 2 3 4 5 6; do
  {
    echo "===== tentativo $TRY ====="
    xcrun xcdevice list 2>&1 || true
    echo "===== showdestinations ====="
    xcodebuild -project "$XCODEPROJ" -scheme "$SCHEME" -showdestinations 2>&1 || true
    echo "===== devicectl ====="
    xcrun devicectl list devices 2>&1 || true
  } >"$DEST_LOG"
  UDID=$(python3 - "$DEST_LOG" <<'PY'
import json, re, sys
text = open(sys.argv[1], errors="replace").read()
chunk = text.split("===== showdestinations =====")[0]
start, end = chunk.find("["), chunk.rfind("]")
if start >= 0 and end > start:
    try:
        devices = json.loads(chunk[start:end + 1])
    except json.JSONDecodeError:
        devices = []
    for device in devices:
        if device.get("simulator"):
            continue
        platform = str(device.get("platform", ""))
        name = str(device.get("name", ""))
        if "iphone" not in platform.lower() and "iPhone" not in name and "iPad" not in name:
            continue
        if device.get("available") is False:
            continue
        ident = device.get("identifier") or ""
        if ident:
            print(ident)
            raise SystemExit
for line in text.splitlines():
    if "platform:iOS" not in line or "Simulator" in line or "placeholder" in line:
        continue
    match = re.search(r"id:([^,}]+)", line)
    if match:
        print(match.group(1).strip())
        raise SystemExit
PY
)
  if [[ -n "$UDID" ]]; then
    break
  fi
  echo "Ancora non lo vedo, riprovo..."
  sleep 5
done
if [[ -z "$UDID" ]]; then
  echo "ERRORE: iPhone non visto. Sbloccalo, tieni il cavo inserito, e rilancia la stessa riga."
  echo "Elenco salvato in $DEST_LOG"
  tail -20 "$DEST_LOG"
  exit 1
fi
echo "iPhone: $UDID"
echo "Compilo. Può volerci qualche minuto. La finestra si aggiorna da sola."

LOG="$HOME/Desktop/everpro-0.5.5-installa.log"
DERIVED="$HOME/Library/Developer/Xcode/DerivedData/EverPro-0.5.5"
rm -rf "$DERIVED" "$HOME/Desktop/everpro-0.5.5-derived"
mkdir -p "$DERIVED"
: >"$LOG"
xcodebuild -project "$XCODEPROJ" -scheme "$SCHEME" -configuration Debug -destination "id=$UDID" -derivedDataPath "$DERIVED" -allowProvisioningUpdates COMPILER_INDEX_STORE_ENABLE=NO build >"$LOG" 2>&1 &
XPID=$!
while kill -0 "$XPID" >/dev/null 2>&1; do
  sleep 8
  LINE=$(tail -1 "$LOG" 2>/dev/null || true)
  echo "… ${LINE:0:120}"
done
wait "$XPID"
BUILD_OK=$?
if [[ "$BUILD_OK" -ne 0 ]]; then
  echo "COMPILAZIONE FALLITA."
  grep -E "error:" "$LOG" | head -30
  echo "Log: $LOG"
  exit 1
fi

APP=$(find "$DERIVED/Build/Products" -name '*.app' -path '*Debug-iphoneos*' -type d 2>/dev/null | head -1)
if [[ -z "$APP" || ! -d "$APP" ]]; then
  echo "ERRORE: app non trovata dopo la compilazione."
  exit 1
fi

if ! find "$APP" \( -name 'Assets.car' -o -name 'AppIcon*' -o -name '*.icns' \) | grep -q .; then
  echo "ERRORE: la build non contiene l'icona. Non la installo, altrimenti sul telefono resta l'icona bianca."
  echo "App: $APP"
  exit 1
fi

VERSION=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$APP/Info.plist" 2>/dev/null || echo "?")
echo "App: $APP"
echo "Versione: $VERSION"
if [[ "$VERSION" != "0.5.12" ]]; then
  echo "ERRORE: versione $VERSION invece di 0.5.12. Non installo."
  exit 1
fi

echo "Installo sull'iPhone..."
if ! xcrun devicectl device install app --device "$UDID" "$APP" >>"$LOG" 2>&1; then
  echo "Installazione non riuscita. Ultime righe:"
  tail -30 "$LOG"
  exit 1
fi

echo ""
echo "FATTO. Sul telefono c'è EverPro 0.5.12."
echo "Apri la pratica: la nota Trasferte mostra il percorso, non il codice EVP-TRIPS."
echo "In Viaggi, la spunta sceglie i percorsi: Stampa li manda in stampa, Mail apre il messaggio con il PDF."
echo "Con percorso, nel PDF compare la mappa del viaggio: la strada percorsa e i punti principali, oltre a partenza e arrivo."
echo "In Impostazioni, a destra, compare v.0.5.12."
osascript -e 'display alert "EverPro 0.5.12 installata" message "Apri la pratica. La nota Trasferte mostra il percorso, non il codice. In Impostazioni compare v.0.5.12."' || true
